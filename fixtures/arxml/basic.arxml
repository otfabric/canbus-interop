<!-- canbus-interop fixture: AUTOSAR 4 CAN cluster: Intel and Motorola signals, standard and extended identifiers, LINEAR, TEXTTABLE, SCALE_LINEAR_AND_TEXTTABLE and IDENTICAL compu methods, signed base types (2C), init values -->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_4-3-0.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Cluster</SHORT-NAME>
      <ELEMENTS>
        <CAN-CLUSTER>
          <SHORT-NAME>Body</SHORT-NAME>
          <CAN-CLUSTER-VARIANTS><CAN-CLUSTER-CONDITIONAL>
            <BAUDRATE>500000</BAUDRATE>
