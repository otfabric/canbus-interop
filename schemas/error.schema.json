{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/canbus-interop/schemas/error.schema.json",
  "title": "canbus-interop error document",
  "type": "object",
  "required": [
    "schemaVersion",
    "type",
    "code",
    "message"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "type": {
      "const": "error"
    },
    "code": {
      "enum": [
        "usage",
        "unsupported",
        "timeout",
        "io",
        "protocol",
        "interface"
      ]
    },
    "message": {
      "type": "string"
    }
  }
}
