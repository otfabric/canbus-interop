{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/canbus-interop/schemas/frame.schema.json",
  "title": "canbus-interop frame document",
  "description": "A CAN or CAN FD frame, or (contract 1.3) a CAN XL frame marked \"xl\": true.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "id",
        "len",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 536870911,
          "description": "Identifier without flag bits (error frames: the error class bits)"
        },
        "extended": {
          "type": "boolean",
          "default": false
        },
        "fd": {
          "type": "boolean",
          "default": false
        },
        "brs": {
          "type": "boolean",
          "default": false
        },
        "esi": {
          "type": "boolean",
          "default": false
        },
        "remote": {
          "type": "boolean",
          "default": false
        },
        "error": {
          "type": "boolean",
          "default": false
        },
        "len": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "Payload length; for remote frames the requested length"
        },
        "data": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})*$"
        },
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{6}$"
        },
        "interface": {
          "type": "string"
        }
      },
      "title": "CAN or CAN FD frame"
    },
    {
      "title": "CAN XL frame (contract 1.3)",
      "type": "object",
      "required": [
        "xl",
        "priority",
        "len",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "xl": {
          "const": true
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2047,
          "description": "11-bit CAN XL priority"
        },
        "vcid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "default": 0,
          "description": "Virtual CAN network identifier"
        },
        "sec": {
          "type": "boolean",
          "default": false,
          "description": "Simple extended content flag (CANXL_SEC)"
        },
        "rrs": {
          "type": "boolean",
          "default": false,
          "description": "Remote request substitution flag (CANXL_RRS)"
        },
        "sdt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "default": 0,
          "description": "SDU type"
        },
        "af": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 0,
          "description": "Acceptance field"
        },
        "len": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "data": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})+$"
        },
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{6}$"
        },
        "interface": {
          "type": "string"
        }
      }
    }
  ]
}
